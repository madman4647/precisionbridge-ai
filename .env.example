# Postgres (Neon via Vercel Marketplace). If unset, an in-process PGlite database is used (in-memory unless PGLITE_DIR is set).
DATABASE_URL=
# Optional: persist PGlite locally, e.g. .data/pglite
PGLITE_DIR=
# Required in production: >= 32 chars, signs the demo session cookie
SESSION_SECRET=change-me-change-me-change-me-change-me
# Optional (P1 only): paraphrase approved check-in wording + plain-language summaries
ANTHROPIC_API_KEY=
# Research small-cell suppression threshold
SMALL_CELL_THRESHOLD=10
