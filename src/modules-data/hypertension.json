  "checkin_question_schema": [
    {
      "id": "sbp",
      "text": "Your most recent top (systolic) blood pressure reading",
      "type": "number",
      "concept": "bp_systolic",
      "unit": "mmHg",
      "allowed_units": [
        "mmHg",
        "kPa"
      ],
      "min": 40,
      "max": 320,
      "required": true,
      "safety_critical": true
    },
    {
      "id": "dbp",
      "text": "Your most recent bottom (diastolic) blood pressure reading",
      "type": "number",
      "concept": "bp_diastolic",
      "unit": "mmHg",
      "allowed_units": [
        "mmHg",
        "kPa"
      ],
      "min": 20,
      "max": 220,
      "required": true,
      "safety_critical": true
    },
    {
      "id": "sx_chest",
      "text": "Right now, do you have chest pain or pressure?",
      "type": "boolean",
      "required": true,
      "safety_critical": true
    },
    {
      "id": "sx_neuro",
      "text": "Right now, do you have sudden weakness, a drooping face, or trouble speaking?",
      "type": "boolean",
      "required": true,
      "safety_critical": true
    },
    {
      "id": "sx_headache_vision",
      "text": "Do you have a severe headache or sudden vision changes?",
      "type": "boolean",
      "required": true,
      "safety_critical": true
    },
    {
      "id": "missed_doses",
      "text": "In the last 7 days, how many doses did you miss? (No judgement — this helps your care team.)",
      "type": "number",
      "min": 0,
      "max": 7,
      "required": true,
      "safety_critical": false
    },
    {
      "id": "side_effects",
      "text": "Any side effects you've noticed?",
      "type": "multi",
      "choices": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "dizziness",
          "label": "Dizziness"
        },
        {
          "value": "cough",
          "label": "Dry cough"
        },
        {
          "value": "swelling",
          "label": "Ankle swelling"
        },
        {
          "value": "other",
          "label": "Other"
        }
      ],
      "required": false,
      "safety_critical": false
    },
    {
      "id": "wellbeing",
      "text": "Overall, how are you feeling today? (1 = very poor, 5 = very good)",
      "type": "scale",
      "min": 1,
      "max": 5,
      "required": false,
      "safety_critical": false
    },
    {
      "id": "free_text",
      "text": "Anything else you want your care team to know? (optional)",
      "type": "text",
      "required": false,
      "safety_critical": false
    }
  ],
  "required_profile_fields": [
    {
      "key": "allergy_status",
      "label": "Allergy status",
      "critical": true,
      "requires_verification": true
    },
    {
      "key": "egfr",
      "label": "Kidney function (eGFR)",
      "critical": true,
      "requires_verification": true,
      "unit": "mL/min/1.73m²"
    },
    {
      "key": "pregnancy_status",
      "label": "Pregnancy status (where applicable)",
      "critical": true,
      "requires_verification": false
    },
    {
      "key": "diagnosis_confirmation",
      "label": "Diagnosis confirmation",
      "critical": false,
      "requires_verification": false
    }
  ],
  "measure_definitions": [
    {
      "concept": "bp_systolic",
      "label": "Systolic blood pressure",
      "canonical_unit": "mmHg",
      "units": {
        "mmHg": 1,
        "kPa": 7.50062
      },
      "plausible_min": 50,
      "plausible_max": 300
    },
    {
      "concept": "bp_diastolic",
      "label": "Diastolic blood pressure",
      "canonical_unit": "mmHg",
      "units": {
        "mmHg": 1,
        "kPa": 7.50062
      },
      "plausible_min": 30,
      "plausible_max": 200
    }
  ],
  "derived_measures": [
    {
      "id": "pulse_pressure",
      "label": "Systolic minus diastolic",
      "op": "diff",
      "of": [
        "obs.bp_systolic",
        "obs.bp_diastolic"
      ]
    }
  ],
  "consistency_rules": [
    {
      "id": "HTN-C1",
      "when": {
        "op": "cmp",
        "field": "derived.pulse_pressure",
        "cmp": "lte",
        "value": 0
      },
      "message": "systolic is not higher than diastolic — possible entry error"
    }
  ],
  "red_flag_rules": [
    {
      "id": "HTN-U1",
      "label": "Chest or stroke-like symptom",
      "when": {
        "op": "or",
        "any": [
          {
            "op": "cmp",
            "field": "answers.sx_chest",
            "cmp": "eq",
            "value": true
          },
          {
            "op": "cmp",
            "field": "answers.sx_neuro",
            "cmp": "eq",
            "value": true
          }
        ]
      },
      "state": "URGENT",
      "patient_message_id": "htn_urgent",
      "rationale": "Structured symptom red flag (chest or neurological symptom). Demo rule, not clinically validated."
    },
    {
      "id": "HTN-U2",
      "label": "Very high BP with severe headache/vision change",
      "when": {
        "op": "and",
        "all": [
          {
            "op": "cmp",
            "field": "obs.bp_systolic",
            "cmp": "gte",
            "value": 180
          },
          {
            "op": "cmp",
            "field": "answers.sx_headache_vision",
            "cmp": "eq",
            "value": true
          }
        ]
      },
      "state": "URGENT",
      "patient_message_id": "htn_urgent",
      "rationale": "Symptom + measurement combination (T03). Demo threshold, not clinically validated."
    },
    {
      "id": "HTN-P1",
      "label": "Elevated BP",
      "when": {
        "op": "or",
        "any": [
          {
            "op": "cmp",
            "field": "obs.bp_systolic",
            "cmp": "gte",
            "value": 160
          },
          {
            "op": "cmp",
            "field": "obs.bp_diastolic",
            "cmp": "gte",
            "value": 100
          }
        ]
      },
      "state": "PROMPT_REVIEW",
      "patient_message_id": "prompt_review",
      "rationale": "BP above demo review threshold (160/100). Demo threshold, not clinically validated."
    },
    {
      "id": "HTN-P2",
      "label": "Low BP",
      "when": {
        "op": "cmp",
        "field": "obs.bp_systolic",
        "cmp": "lt",
        "value": 90
      },
      "state": "PROMPT_REVIEW",
      "patient_message_id": "prompt_review",
      "rationale": "Systolic below demo review threshold (90). Demo threshold, not clinically validated."
    },
    {
      "id": "HTN-P3",
      "label": "Several missed doses",
      "when": {
        "op": "cmp",
        "field": "answers.missed_doses",
        "cmp": "gte",
        "value": 4
      },
      "state": "PROMPT_REVIEW",
      "patient_message_id": "prompt_review",
      "rationale": "4 or more missed doses in 7 days. Demo threshold."
    },
    {
      "id": "HTN-P4",
      "label": "Severe headache / vision change",
      "when": {
        "op": "cmp",
        "field": "answers.sx_headache_vision",
        "cmp": "eq",
        "value": true
      },
      "state": "PROMPT_REVIEW",
      "patient_message_id": "prompt_review",
      "rationale": "Reported severe headache or vision change."
    }
  ],
  "free_text_keywords": [
    {
      "id": "HTN-FT1",
      "pattern": "chest pain|can'?t breathe|faint|collapsed|stroke",
      "state": "PROMPT_REVIEW"
    }
  ],
  "patient_messages": {
    "htn_urgent": "Your answers include a symptom that needs urgent attention. Call your local emergency number now or go to the nearest emergency department. Do not drive yourself if you feel unwell."
  },
