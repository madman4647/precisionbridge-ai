  "checkin_question_schema": [
    {
      "id": "phq9_1",
      "text": "PHQ-9 item 1: Over the last 2 weeks, how often have you been bothered by: little interest or pleasure in doing things",
      "type": "choice",
      "choices": [
        {
          "value": "0",
          "label": "Not at all"
        },
        {
          "value": "1",
          "label": "Several days"
        },
        {
          "value": "2",
          "label": "More than half the days"
        },
        {
          "value": "3",
          "label": "Nearly every day"
        }
      ],
      "min": 0,
      "max": 3,
      "required": true,
      "safety_critical": false
    },
    {
      "id": "phq9_2",
      "text": "PHQ-9 item 2: Over the last 2 weeks, how often have you been bothered by: feeling down, depressed, or hopeless",
