    {
      "id": "selfharm_now",
      "text": "Are you thinking about harming yourself or ending your life right now, or do you have a plan or intent to?",
      "type": "boolean",
      "required": true,
      "safety_critical": true
    },
    {
      "id": "missed_doses",
      "text": "In the last 7 days, how many doses did you miss? (No judgement — this helps your care team.)",
      "type": "number",
      "min": 0,
      "max": 7,
      "required": true,
      "safety_critical": false
    },
    {
      "id": "side_effects",
      "text": "Any side effects you've noticed?",
      "type": "multi",
      "choices": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "nausea",
          "label": "Nausea"
        },
        {
          "value": "agitation",
          "label": "Agitation or feeling wired"
        },
        {
          "value": "sleep",
          "label": "Sleep changes"
        },
        {
          "value": "sexual",
          "label": "Sexual side effects"
        },
        {
          "value": "other",
          "label": "Other"
        }
      ],
      "required": false,
      "safety_critical": false
    },
