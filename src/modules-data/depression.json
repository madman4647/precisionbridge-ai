  "measure_definitions": [],
  "derived_measures": [
    {
      "id": "phq9_total",
      "label": "PHQ-9 total",
      "op": "sum",
      "of": [
        "answers.phq9_1",
        "answers.phq9_2",
        "answers.phq9_3",
        "answers.phq9_4",
        "answers.phq9_5",
        "answers.phq9_6",
        "answers.phq9_7",
        "answers.phq9_8",
        "answers.phq9_9"
      ]
    }
  ],
  "consistency_rules": [
    {
      "id": "DEP-C1",
      "when": {
        "op": "and",
        "all": [
          {
            "op": "cmp",
            "field": "answers.phq9_9",
            "cmp": "eq",
            "value": 0
          },
          {
            "op": "cmp",
            "field": "answers.selfharm_now",
            "cmp": "eq",
            "value": true
          }
        ]
      },
      "message": "item 9 reported 0 but direct self-harm question is positive"
    }
  ],
  "red_flag_rules": [
    {
      "id": "DEP-U1",
      "label": "Immediate self-harm danger (direct question)",
      "when": {
        "op": "cmp",
        "field": "answers.selfharm_now",
        "cmp": "eq",
        "value": true
      },
      "state": "URGENT",
      "patient_message_id": "dep_urgent",
      "rationale": "Structured direct self-harm question positive. Human-led safety response required. Demo rule."
    },
    {
      "id": "DEP-U2",
      "label": "PHQ-9 item 9 ≥ 2",
      "when": {
        "op": "cmp",
        "field": "answers.phq9_9",
        "cmp": "gte",
        "value": 2
      },
      "state": "URGENT",
      "patient_message_id": "dep_urgent",
      "rationale": "Item 9 'more than half the days' or higher. Demo threshold, not clinically validated."
    },
    {
      "id": "DEP-P1",
      "label": "PHQ-9 item 9 positive",
      "when": {
        "op": "cmp",
        "field": "answers.phq9_9",
        "cmp": "gte",
        "value": 1
      },
      "state": "PROMPT_REVIEW",
      "patient_message_id": "dep_support",
      "rationale": "Item 9 'several days'. Structured human-care pathway and help information shown. Demo threshold."
    },
    {
      "id": "DEP-P2",
      "label": "Severe symptom score",
      "when": {
        "op": "cmp",
        "field": "derived.phq9_total",
        "cmp": "gte",
        "value": 20
      },
      "state": "PROMPT_REVIEW",
      "patient_message_id": "prompt_review",
      "rationale": "PHQ-9 total ≥ 20. Demo threshold."
    },
    {
      "id": "DEP-P3",
      "label": "Activation / agitation side effect",
      "when": {
        "op": "includes",
        "field": "answers.side_effects",
        "value": "agitation"
      },
      "state": "PROMPT_REVIEW",
      "patient_message_id": "prompt_review",
      "rationale": "Reported agitation side effect warrants timely review."
    },
    {
      "id": "DEP-P4",
      "label": "Several missed doses",
      "when": {
        "op": "cmp",
        "field": "answers.missed_doses",
        "cmp": "gte",
        "value": 4
      },
      "state": "PROMPT_REVIEW",
      "patient_message_id": "prompt_review",
      "rationale": "4 or more missed doses in 7 days. Demo threshold."
    }
  ],
  "free_text_keywords": [
    {
      "id": "DEP-FT1",
      "pattern": "suicid|kill myself|end my life|self[- ]?harm|overdose|better off dead",
      "state": "PROMPT_REVIEW"
    }
  ],
  "patient_messages": {
    "dep_urgent": "You told us something that needs a person to help you right away. You do not have to manage this alone. Please contact emergency services or a crisis line now and stay with someone you trust.",
    "dep_support": "Thank you for telling us. Thoughts of harming yourself matter. A clinician will review your check-in. If these thoughts get stronger or you feel you might act on them, contact emergency services or a crisis line straight away."
  },
