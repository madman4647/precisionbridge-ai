  "checkin_question_schema": [
    {
      "id": "glucose",
      "text": "Your most recent blood glucose reading (if you measured one)",
      "type": "number",
      "concept": "glucose",
      "unit": "mg/dL",
      "allowed_units": [
        "mg/dL",
        "mmol/L"
      ],
      "min": 1,
      "max": 1000,
      "required": false,
      "safety_critical": false
    },
    {
      "id": "sx_severe_hypo",
      "text": "Have you had severe low-sugar symptoms (confusion, fainting, or needing someone else's help)?",
      "type": "boolean",
      "required": true,
      "safety_critical": true
    },
    {
      "id": "sx_vomit",
      "text": "Are you vomiting, unable to keep fluids down, or feeling very unwell?",
      "type": "boolean",
      "required": true,
      "safety_critical": true
    },
    {
      "id": "sx_mild_hypo",
      "text": "Have you had shaky/sweaty low-sugar episodes that you treated yourself this week?",
      "type": "boolean",
      "required": true,
      "safety_critical": false
    },
    {
      "id": "missed_doses",
      "text": "In the last 7 days, how many doses did you miss? (No judgement — this helps your care team.)",
      "type": "number",
      "min": 0,
      "max": 7,
      "required": true,
      "safety_critical": false
    },
    {
      "id": "side_effects",
      "text": "Any side effects you've noticed?",
      "type": "multi",
      "choices": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "nausea",
          "label": "Nausea"
        },
        {
          "value": "diarrhoea",
          "label": "Diarrhoea"
        },
        {
          "value": "genital_irritation",
          "label": "Genital irritation"
        },
        {
          "value": "other",
          "label": "Other"
        }
      ],
      "required": false,
      "safety_critical": false
    },
    {
      "id": "wellbeing",
      "text": "Overall, how are you feeling today? (1 = very poor, 5 = very good)",
      "type": "scale",
      "min": 1,
      "max": 5,
      "required": false,
      "safety_critical": false
    },
    {
      "id": "free_text",
      "text": "Anything else you want your care team to know? (optional)",
      "type": "text",
      "required": false,
      "safety_critical": false
    }
  ],
  "required_profile_fields": [
    {
      "key": "allergy_status",
      "label": "Allergy status",
      "critical": true,
      "requires_verification": true
    },
    {
      "key": "egfr",
      "label": "Kidney function (eGFR)",
      "critical": true,
      "requires_verification": true,
      "unit": "mL/min/1.73m²"
    },
    {
      "key": "hba1c",
      "label": "HbA1c",
      "critical": false,
      "requires_verification": false,
      "unit": "mmol/mol"
    }
  ],
  "measure_definitions": [
    {
      "concept": "glucose",
      "label": "Blood glucose",
      "canonical_unit": "mg/dL",
      "units": {
        "mg/dL": 1,
        "mmol/L": 18.016
      },
      "plausible_min": 20,
      "plausible_max": 900
    }
  ],
  "derived_measures": [],
  "consistency_rules": [],
  "red_flag_rules": [
    {
      "id": "T2D-U1",
      "label": "Severe low-glucose symptoms",
      "when": {
        "op": "cmp",
        "field": "answers.sx_severe_hypo",
        "cmp": "eq",
        "value": true
      },
      "state": "URGENT",
      "patient_message_id": "t2d_urgent",
      "rationale": "Structured severe hypoglycaemia symptom. Demo rule, not clinically validated."
    },
    {
      "id": "T2D-U2",
      "label": "Very low glucose reading",
      "when": {
        "op": "cmp",
        "field": "obs.glucose",
        "cmp": "lt",
        "value": 54
      },
      "state": "URGENT",
      "patient_message_id": "t2d_urgent",
      "rationale": "Glucose below demo urgent threshold (54 mg/dL). Demo threshold, not clinically validated."
    },
    {
      "id": "T2D-U3",
      "label": "Very high glucose with vomiting",
      "when": {
        "op": "and",
        "all": [
          {
            "op": "cmp",
            "field": "obs.glucose",
            "cmp": "gte",
            "value": 400
          },
          {
            "op": "cmp",
            "field": "answers.sx_vomit",
            "cmp": "eq",
            "value": true
          }
        ]
      },
      "state": "URGENT",
      "patient_message_id": "t2d_urgent",
      "rationale": "Possible acute metabolic illness (high glucose + vomiting). Demo threshold."
    },
    {
      "id": "T2D-P1",
      "label": "Low glucose reading",
      "when": {
        "op": "cmp",
        "field": "obs.glucose",
        "cmp": "lt",
        "value": 70
      },
      "state": "PROMPT_REVIEW",
      "patient_message_id": "prompt_review",
      "rationale": "Glucose below demo review threshold (70 mg/dL). Demo threshold."
    },
    {
      "id": "T2D-P2",
      "label": "High glucose reading",
      "when": {
        "op": "cmp",
        "field": "obs.glucose",
        "cmp": "gte",
        "value": 300
      },
      "state": "PROMPT_REVIEW",
      "patient_message_id": "prompt_review",
      "rationale": "Glucose above demo review threshold (300 mg/dL). Demo threshold."
    },
    {
      "id": "T2D-P3",
      "label": "Vomiting / very unwell",
      "when": {
        "op": "cmp",
        "field": "answers.sx_vomit",
        "cmp": "eq",
        "value": true
      },
      "state": "PROMPT_REVIEW",
      "patient_message_id": "prompt_review",
      "rationale": "Acute illness flag supersedes ranking."
    },
    {
      "id": "T2D-P4",
      "label": "Self-treated low-sugar episodes",
      "when": {
        "op": "cmp",
        "field": "answers.sx_mild_hypo",
        "cmp": "eq",
        "value": true
      },
      "state": "PROMPT_REVIEW",
      "patient_message_id": "prompt_review",
      "rationale": "Recurrent hypoglycaemia symptoms warrant review."
    },
    {
      "id": "T2D-P5",
      "label": "Several missed doses",
      "when": {
        "op": "cmp",
        "field": "answers.missed_doses",
        "cmp": "gte",
        "value": 4
      },
      "state": "PROMPT_REVIEW",
      "patient_message_id": "prompt_review",
      "rationale": "4 or more missed doses in 7 days. Demo threshold."
    }
  ],
  "free_text_keywords": [
    {
      "id": "T2D-FT1",
      "pattern": "unconscious|seizure|passed out|blacked out",
      "state": "PROMPT_REVIEW"
    }
  ],
  "patient_messages": {
    "t2d_urgent": "Your answers suggest a possible low blood sugar emergency or a serious illness. If you are able, follow the low-sugar plan you were given, then call your local emergency number or have someone take you to emergency care now. Do not wait for a reply from this app."
  },
